# Copy to apps/frontend/.env (Vite only exposes variables prefixed with VITE_,
# and they are baked into the public JS bundle — never put secrets here).

# Backend API base URL
VITE_API_BASE_URL="http://localhost:3000"

# PostHog product analytics. Leave empty to disable (events are logged to the
# console in dev instead). Project API key from PostHog → Project settings.
# VITE_POSTHOG_KEY="phc_..."
# US cloud: https://us.i.posthog.com  |  EU cloud: https://eu.i.posthog.com
# VITE_POSTHOG_HOST="https://us.i.posthog.com"
