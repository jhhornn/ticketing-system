# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/ticketing_system?schema=public"

# ==============================================
# JWT AUTHENTICATION (REQUIRED)
# ==============================================
# Secret key for JWT token signing
# **CRITICAL**: Use a strong random string in production
# Generate with: openssl rand -base64 32
# **WARNING**: Application will NOT start without this!
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="24h"

# ==============================================
# REDIS CONFIGURATION
# ==============================================
# Redis host for caching and distributed locks
REDIS_HOST="localhost"
# Redis port
REDIS_PORT="6379"
# Redis password (optional, leave empty if no auth)
REDIS_PASSWORD=""
# Redis database number (default: 0)
REDIS_DB="0"

# ==============================================
# APPLICATION SETTINGS
# ==============================================
# Application port
PORT="3000"
# Node environment (development | production | test)
NODE_ENV="development"

# ==============================================
# OBSERVABILITY (LOGGING + OPENTELEMETRY)
# ==============================================
# Log level: debug, info, warn, error
# Development: debug (verbose)
# Production: info (standard)
LOG_LEVEL="info"

# Deployment metadata (attached to every log, trace and metric).
# Leave these unset — they're resolved automatically (common/config/deployment-info.ts):
#   APP_VERSION → package.json version (via pnpm scripts)        → "dev"
#   GIT_COMMIT  → RENDER_GIT_COMMIT on Render                     → "unknown"
#   HOSTNAME    → RENDER_INSTANCE_ID on Render                    → OS hostname
#   REGION      → Render has no region variable; set it there     → "local"
# Note: dotenv does not expand shell syntax like ${GIT_COMMIT:-unknown}.
# APP_VERSION="1.0.0"
# GIT_COMMIT="<commit sha>"
# REGION="frankfurt"
# HOSTNAME="<instance name>"

# Telemetry fans out to every enabled destination:
#   1. This generic OTLP endpoint (Jaeger / OTel Collector / any vendor).
#      Used by default outside production. In production it is only used if
#      you set it, so you can run PostHog-only without a collector.
#   2. PostHog — automatically when POSTHOG_API_KEY is set (see below).
# Local Jaeger all-in-one usually listens on http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"

# Service name shown in your tracing backend
OTEL_SERVICE_NAME="ticketing-api"

# Optional auth header for secured collectors
# OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer <token>"

# Trace sampling (standard OTel vars). Keep 100% while traffic is low; lower
# it if trace volume/cost grows, e.g. keep 20% of new traces:
OTEL_TRACES_SAMPLER="parentbased_traceidratio"
OTEL_TRACES_SAMPLER_ARG="0.2"

# Optional per-signal endpoints (override OTEL_EXPORTER_OTLP_ENDPOINT)
# Useful when logs, traces, and metrics go to different backends.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="http://localhost:4318/v1/traces"
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT="http://localhost:4318/v1/metrics"
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT="http://otel-collector:4318/v1/logs"

# Optional per-signal auth headers (falls back to OTEL_EXPORTER_OTLP_HEADERS)
# Header format: comma-separated key=value pairs
# OTEL_EXPORTER_OTLP_METRICS_HEADERS="Authorization=Bearer <token>,x-tenant-id=acme"
# OTEL_EXPORTER_OTLP_LOGS_HEADERS="Authorization=Bearer <token>"

# Optional logs fan-out to multiple OTLP backends (comma-separated URLs).
# Example: send the same logs to two different collectors/backends.
# OTEL_EXPORTER_OTLP_LOGS_ADDITIONAL_ENDPOINTS="http://collector-a:4318/v1/logs,http://collector-b:4318/v1/logs"

# Bridge app logs (pino) into OTel LogRecords so they are exported via OTLP.
# Set to "false" only if you want stdout-only logs.
OTEL_LOG_BRIDGE_ENABLED="true"

# ==============================================
# CORS CONFIGURATION
# ==============================================
# Comma-separated list of allowed origins
# Development: http://localhost:5173
# Production: https://your-domain.com,https://www.your-domain.com
CORS_ORIGINS="http://localhost:5173"

# ==============================================
# RESERVATION SETTINGS
# ==============================================
# Reservation timeout in minutes (default: 10)
RESERVATION_TIMEOUT_MINUTES="10"
# Lock TTL in seconds for distributed locking (default: 30)
LOCK_TTL_SECONDS="30"
# Minutes a booking may wait for payment (e.g. Paystack checkout) before its
# seats are released (default: 30). The provider is checked first, so a paid
# booking whose webhook was missed is still confirmed.
PENDING_PAYMENT_TIMEOUT_MINUTES="30"
# Release even if the provider can't confirm the outcome after this long
# (default: 120). A payment that succeeds later is refunded automatically.
PENDING_PAYMENT_MAX_MINUTES="120"

# ==============================================
# PAYMENT CONFIGURATION
# ==============================================
# Default payment provider (mock | paystack | stripe)
DEFAULT_PAYMENT_PROVIDER=paystack

# The mock provider always succeeds (free tickets). It is only available when
# NODE_ENV is development/test, or when this is explicitly set to "true".
# NEVER enable this in production.
# ENABLE_MOCK_PAYMENTS="false"

# Paystack Configuration
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
# Callback URL — where Paystack redirects the user after payment.
# Must match the route in your frontend (e.g. /payment/verify).
PAYSTACK_CALLBACK_URL="http://localhost:5173/payment/verify"

# Stripe Configuration (uncomment if using Stripe)
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ==============================================
# EMAIL CONFIGURATION
# ==============================================
# Email service provider (MOCK | SENDGRID)
EMAIL_PROVIDER="MOCK"

# SendGrid Configuration (uncomment if using SendGrid)
# SENDGRID_API_KEY="SG...."
# SENDGRID_FROM_EMAIL="noreply@yourdomain.com"
# SENDGRID_FROM_NAME="Ticketing System"

# ==============================================
# PRODUCT ANALYTICS (POSTHOG)
# ==============================================
# Server-side events (bookings confirmed/released, refunds, sign-ups).
# Use the same project API key as the frontend (phc_..., it is not a secret).
# Leave empty to disable.
# POSTHOG_API_KEY="phc_..."
# US cloud: https://us.i.posthog.com  |  EU cloud: https://eu.i.posthog.com
# POSTHOG_HOST="https://us.i.posthog.com"
# The same key also ships backend logs, metrics and traces to PostHog
# (Logs / Metrics / Tracing products) over OTLP. Pick signals, or "none":
# POSTHOG_OTEL_SIGNALS="traces,metrics,logs"

# ==============================================
# OPTIONAL SETTINGS
# ==============================================
# API docs at /api — on by default outside production, off in production.
# ENABLE_API_DOCS="false"

# Express "trust proxy" hops. Defaults to 1 in production (Render) so rate
# limiting sees the real client IP; off elsewhere.
# TRUST_PROXY="1"

# Seeding: only runs freely against a local development/test database.
# To seed any other database you must set BOTH of these.
# ALLOW_REMOTE_SEED="false"
# SEED_USER_PASSWORD="<at least 12 characters>"

# Prisma Studio Port (optional)
# PRISMA_STUDIO_PORT=5555

# ==============================================
# SECURITY CHECKLIST FOR PRODUCTION
# ==============================================
# ✓ 1. Generate a strong JWT_SECRET (32+ random characters)
# ✓ 2. Set JWT_SECRET as environment variable (never hardcode)
# ✓ 3. Use SSL/TLS for DATABASE_URL (sslmode=require)
# ✓ 4. Enable Redis authentication (set REDIS_PASSWORD)
# ✓ 5. Restrict CORS_ORIGINS to your actual domain(s)
# ✓ 6. Set NODE_ENV="production"
# ✓ 7. Use secure PostgreSQL credentials
# ✓ 8. Never commit .env files to version control
# ✓ 9. Rotate secrets regularly (quarterly recommended)
# ✓ 10. Enable rate limiting and DDoS protection

